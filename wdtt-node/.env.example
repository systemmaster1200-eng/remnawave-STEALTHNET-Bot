# WDTT Node Configuration
# Copy this file to .env and fill in the values

# Главный пароль (владелец сервера)
MAIN_PASSWORD=changeme

# VK Hash — хеш из ссылки VK-звонка (обязательно для работы TURN-релея)
# Формат: просто хеш из ссылки vk.com/call/join/XXXXXXXXXXX
# Или вся ссылка целиком
VK_HASH=

# Telegram бот (опционально, для управления через бота)
ADMIN_ID=
BOT_TOKEN=

# Порты (стандартные значения)
DTLS_PORT=56000
WG_PORT=56001
API_PORT=9000

# Публичный IP или домен сервера (для wdtt:// ссылок)
# Если пусто, будет определён автоматически через api.ipify.org
PUBLIC_HOST=

# API ключ для авторизации запросов от STEALTHNET
# Сгенерируйте: openssl rand -hex 32
API_KEY=
